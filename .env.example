# ── Déploiement ───────────────────────────────────────────────────────────────
# Origine publique, telle que le navigateur la voit. Sert aussi d'origine de
# confiance (CORS) et d'URL de base pour l'authentification.
PUBLIC_URL=http://localhost:8080
APP_PORT=8080
# Sous-chemin, si l'application n'est pas à la racine du domaine (ex. /assistants).
BASE_PATH=

# ── Base de données ───────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=assistants

# ── Authentification ──────────────────────────────────────────────────────────
# openssl rand -base64 32
#
# Ce secret et OIDC_CLIENT_SECRET acceptent une variante _FILE, qui prime :
#   BETTER_AUTH_SECRET_FILE=/app/.secrets/auth-secret
# Une variable d'environnement se lit dans `docker inspect`, dans les journaux de
# l'orchestrateur et dans /proc ; un fichier en 0600 lisible du seul propriétaire, non.
# Un fichier déclaré mais illisible fait ÉCHOUER le démarrage au lieu de retomber
# silencieusement sur la variable — sinon on croirait avoir posé le nouveau secret.
BETTER_AUTH_SECRET=

# SSO OIDC (dex). Vide = SSO désactivé, seul le compte de secours fonctionne.
#
# Ces variables s'appelaient OUATE_*, du nom de l'annuaire qui les a vues naître. Les anciens
# noms restent lus en repli, sans date de péremption : un .env déjà en service n'a rien à
# changer. Le nom actuel l'emporte dès qu'il porte une valeur non vide — jamais sur sa seule
# présence, car docker-compose les définit toutes. Voir packages/auth/src/env.ts.
#
# Le secret client est ici et NON chiffré en base : genericOAuth lit sa configuration à
# l'initialisation du module, avant que la base soit joignable. C'est la seule exception à
# « aucun secret en variable d'environnement » — la clé de chiffrement des réglages, elle,
# vit dans .secrets/settings.key. Voir doc/Installation.md.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=
OIDC_NC_URL=
# Sous-chemin uniquement. À la racine, laisser vide.
OIDC_REDIRECT_URI=

# Groupe qui confère le rôle administrateur.
OIDC_GROUPE_ADMIN=admins

# Dernier fragment de l'URL de rappel enregistrée chez le fournisseur :
# <PUBLIC_URL>/api/auth/oauth2/callback/<OIDC_PROVIDER_ID>. Le changer exige de changer
# l'enregistrement là-bas, faute de quoi le retour de connexion tombe sur un 404. Laissé
# vide, le code retient son défaut historique, pour qu'une instance déjà déclarée continue
# de fonctionner.
OIDC_PROVIDER_ID=oidc
# Ce que le bouton de connexion affiche. À défaut, l'identifiant ci-dessus en capitales.
OIDC_LIBELLE=SSO

# QUI PEUT ENTRER PAR LE SSO.
#
#   true  — les administrateurs SEULS. Tout autre compte reçoit un 403 explicite.
#           C'est le réglage d'une phase d'essai : on vérifie ce que l'assistant répond
#           avant de l'ouvrir.
#   false — tout membre du groupe déclaré dans le réglage `instance.groupe_sso`.
#
# En variable d'environnement et non en réglage de base : un réglage qui décide QUI peut se
# connecter, modifiable depuis l'application, se retourne mal — une fausse manœuvre ouvre
# l'accès et personne ne s'en aperçoit. L'environnement demande un redéploiement, ce qui est
# le bon niveau de friction pour cette décision.
OIDC_ADMINS_SEULEMENT=false

# ── RETOUR DE BOUCLE VERS L'HÔTE ──────────────────────────────────────────────
#
# À renseigner quand les services interrogés — fournisseur OIDC, GitLab, API métier —
# vivent sur LA MÊME MACHINE, derrière le même proxy. Le conteneur les cherche à leur
# nom PUBLIC, qui résout vers l'adresse EXTERNE de la machine, laquelle n'est pas
# joignable depuis l'intérieur du réseau Docker faute de retour de boucle NAT.
#
# Le symptôme est trompeur : « Unable to connect » sur une URL qui répond parfaitement
# depuis un navigateur du même serveur. Et pour le fournisseur OIDC, ce n'est même pas
# un avertissement — l'authentification REFUSE DE DÉMARRER.
#
# Chaque nom renseigné ici est épinglé vers l'hôte ; un emplacement vide reste inerte.
# IP_VM vide = `host-gateway`, qui suffit dans la plupart des cas.
IP_VM=

# Le portail qui héberge le fournisseur OIDC.
HOTE_PORTAIL=
HOTE_SNIFF=
HOTE_CATALOGUE=
HOTE_NEXTCLOUD=
HOTE_IA=
HOTE_AUTRE=

# ── Indexation ────────────────────────────────────────────────────────────────
# Période de RÉVEIL du service de synchronisation, en secondes. Ce n'est pas la fréquence
# d'indexation : le binaire se réveille, regarde `synchro.intervalle_h` en base, et ne fait
# rien s'il est trop tôt. Régler la fréquence dans l'interface, pas ici.
SYNCHRO_PERIODE=1800
# Plafond mémoire du processus d'indexation. Il meurt proprement au lieu de laisser l'OOM
# killer de l'hôte choisir sa victime — qui serait GitLab, pas lui.
SYNCHRO_MEM=1g

# ── Sauvegardes ───────────────────────────────────────────────────────────────
ASSISTANTS_BACKUP_KEEP=14
