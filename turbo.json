{
    "$schema": "https://turborepo.dev/schema.json",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": [".nuxt/**", ".output/**", "dist/**"]
        },
        "lint": {},
        "typecheck": { "dependsOn": ["^typecheck"] },
        "dev": { "cache": false, "persistent": true }
    },
    "ui": "tui",
    "globalEnv": [
        "DATABASE_URL", "PORT", "HOST", "TRUSTED_ORIGINS",
        "BETTER_AUTH_URL", "BETTER_AUTH_SECRET", "AUTH_DOMAIN",
        "OIDC_CLIENT_ID", "OIDC_CLIENT_SECRET", "OIDC_CLIENT_SECRET_FILE", "OIDC_DISCOVERY_URL", "OIDC_NC_URL", "OIDC_REDIRECT_URI", "OIDC_GROUPE_ADMIN", "OIDC_PROVIDER_ID", "OIDC_LIBELLE",
        "OUATE_CLIENT_ID", "OUATE_CLIENT_SECRET", "OUATE_DISCOVERY_URL", "OUATE_NC_URL", "OUATE_REDIRECT_URI", "OUATE_GROUPE_ADMIN", "OIDC_ADMINS_SEULEMENT", "BASE_PATH", "NUXT_APP_BASE_URL",
        "SETTINGS_KEY_FILE", "SETTINGS_ENCRYPTION_KEY",
        "NUXT_PUBLIC_SERVER_BASE_URL"
    ]
}
