{
  "name": "assistants",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "doc:reglages": "bun run packages/database/src/registre/generer.ts",
    "doc:verifier": "bun run packages/database/src/registre/generer.ts --verifier && bun run packages/database/src/registre/connecteurs.ts --verifier",
    "doc:connecteurs": "bun run packages/database/src/registre/connecteurs.ts"
  },
  "devDependencies": {
    "turbo": "^2.8.15",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
